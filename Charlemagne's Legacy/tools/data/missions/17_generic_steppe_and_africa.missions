# Generic trees for the minor realms of the steppe and of Africa: the realms of tags.db that match the select (and have the column
# free) get them. They use the base game's generic kind of condition (growth since the mission began, the home area and region)
# so that one tree fits every realm; a realm with its own series in the same column keeps that one.

[steppe_expansion]
slot = 4
select = tech nomad_group
shield = no
modifier = kar_steppe_raiders | Steppe Raiders | The horsemen ride out each spring and come back with silver, cloth and captives. | loot_amount 0.15, cavalry_power 0.10
modifier = kar_steppe_khanate | A Khanate Worth the Name | Clans that once fought one another now ride together under one banner. | legitimacy 1, land_morale 0.05

mission = anda | Sworn Brothers | A khan with no friends is a khan with many enemies; the clans swear brotherhood with a neighbour.
row = 1
icon = mission_alliances
when = allies 1
reward = prestige 10 ; dip 50

mission = raid | Raid the Sown Lands | The farmers and townsmen of the neighbouring lands pay richly for peace, and richer for war.
row = 2
needs = anda
icon = mission_steppe_warriors
when = grown_dev 30
reward = prestige 10 ; modifier kar_steppe_raiders 15 ; claim_neighbours

mission = pastures | The Home Pastures | The best grass and the best wells are the clan's right; all of them must be under one khan.
row = 3
needs = raid
icon = mission_bedouins
when = home_area
reward = prestige 10 ; claim_neighbour_areas

mission = khanate | A Khanate Worth the Name | Four new lands at the khan's feet make the clans a people with a future.
row = 4
needs = pastures
icon = mission_central_asian_city
when = grown_states 4
reward = prestige 15 ; modifier kar_steppe_khanate 15

mission = lord_of_the_steppe | Lord of the Steppe | When the whole home region rides under one banner, no neighbour dares to let the herds graze its border.
row = 5
needs = khanate
icon = mission_unite_home_region
when = home_region
reward = prestige 25 ; stability 1

[steppe_realm]
slot = 5
select = tech nomad_group
shield = no
modifier = kar_steppe_hearth | The Great Camp | The khan's great camp keeps the herds fed and the riders fit through the winter. | land_maintenance_modifier -0.05, manpower_recovery_speed 0.10
modifier = kar_steppe_tribute | Tribute from the Sown | Cities and oases send silver and silk to the khan rather than see his riders. | trade_efficiency 0.10, global_tax_modifier 0.05

mission = kurultai | The Kurultai | The lords of the clans meet to elect the khan and to swear that his word will be obeyed in war.
row = 1
icon = mission_noble_council
when = allies 2
reward = prestige 10 ; mil 50

mission = herds | Herds and Horses | A full horse-herd is wealth, food and an army; the khan counts his animals and his men together.
row = 2
needs = kurultai
icon = mission_war_chest
when = treasury 150
reward = adm 50 ; modifier kar_steppe_hearth 15

mission = companions | The Khan's Companions | A khan's sworn warriors ride beside him in every campaign, and their fame makes recruits.
row = 3
needs = herds
icon = mission_steppe_warriors
when = tradition 25
reward = mil 50 ; prestige 10

mission = tribute | Tribute from the Sown | The farmers and city-dwellers beside the steppe pay tribute for peace.
row = 4
needs = companions
icon = mission_market_place_with_asian_traders
when = treasury 400 ; dev 120
reward = prestige 10 ; modifier kar_steppe_tribute 15

mission = oasis | Oasis and Caravan Cities | The caravan cities on the steppe's rim bring silk, horses and learned men to the khan's court.
row = 5
needs = tribute
icon = mission_asian_trader
when = dev 250 ; subjects 1
reward = prestige 20 ; adm 50

[savanna_expansion]
slot = 4
select = tech sub_saharan
shield = no
modifier = kar_smiths_fires | The Smiths' Fires | Iron hoes and spears from the furnaces of the villages spread across the land. | production_efficiency 0.10, infantry_power 0.05
modifier = kar_savanna_kingdom | The Kingdom | Chiefs of many villages kneel to one king, and the royal drum calls them to his court. | legitimacy 1, stability_cost_modifier -0.10

mission = elders | The Council of Elders | The elders of the clans advise the chief; the chief takes a wife from a neighbouring lineage and gains an ally.
row = 1
icon = mission_alliances
when = allies 1
reward = prestige 10 ; dip 50

mission = smiths | The Smiths' Fires | The smiths of the realm make iron tools and weapons, and the land beyond is cleared for new villages.
row = 2
needs = elders
icon = mission_early_game_buildings
when = grown_dev 30
reward = prestige 10 ; modifier kar_smiths_fires 15 ; claim_neighbours

mission = homeland | The Homeland | The rivers, the fields and the sacred groves of the homeland must all be under the chief's drum.
row = 3
needs = smiths
icon = mission_african_soldier
when = home_area
reward = prestige 10 ; claim_neighbour_areas

mission = chiefs | Chiefs Become Vassals | Neighbouring chiefs who cannot be beaten are made vassals, and the king's rule spreads without constant war.
row = 4
needs = homeland
icon = mission_have_two_subjects
when = grown_states 3 ; subjects 1
reward = prestige 15 ; modifier kar_savanna_kingdom 15

mission = the_kingdom | Master of the Region | When the whole region obeys one king, caravans, craftsmen and priests all look to his court.
row = 5
needs = chiefs
icon = mission_unite_home_region
when = home_region
reward = prestige 25 ; stability 1

[savanna_realm]
slot = 5
select = tech sub_saharan
shield = no
modifier = kar_trans_saharan_trade | Trans-Saharan Trade | Salt, copper, gold and cloth move along the caravan roads, and the king taxes them. | caravan_power 0.20, trade_efficiency 0.05
modifier = kar_sacred_kingship | Sacred Kingship | The king is the keeper of the sacred groves and the rain, and his people believe it. | tolerance_own 2, legitimacy 0.5

mission = markets | The Great Market | A weekly market in the capital draws traders from three days' journey in every direction.
row = 1
icon = mission_market_place_with_asian_traders
when = allies 2
reward = prestige 10 ; dip 50

mission = salt_and_gold | Salt and Gold | Caravans from the north bring salt, copper and cloth to the kingdom, and carry away gold and ivory.
row = 2
needs = markets
icon = mission_asian_trader
when = treasury 150
reward = adm 50 ; modifier kar_trans_saharan_trade 15

mission = shrines | Shrines of the Ancestors | The king keeps the shrines of his ancestors, and his rule rests on the blessings of the dead.
row = 3
needs = salt_and_gold
icon = mission_hands_praying
when = stability 2 ; prestige 40
reward = prestige 10 ; modifier kar_sacred_kingship 15

mission = royal_city | The Royal City | A walled royal city with its markets, workshops and palace shows the world the kingdom's strength.
row = 4
needs = shrines
icon = mission_hanseatic_city
when = dev 150 ; cities 8
reward = prestige 15 ; adm 50

[horn_expansion]
slot = 4
select = tech east_african
shield = no
modifier = kar_highland_granary | Highland Granary | Terraced fields on the high plateau feed the court, the church and the army. | production_efficiency 0.10, global_tax_modifier 0.05
modifier = kar_coastal_reach | Coastal Reach | Ports on the Red Sea and the Indian Ocean give the highlands a window on the world. | galley_power 0.10, trade_range_modifier 0.10

mission = ties | Dynastic Ties | A king in the highlands marries into the neighbouring houses and finds allies among the lowland chiefs.
row = 1
icon = mission_alliances
when = allies 1
reward = prestige 10 ; dip 50

mission = terraces | The Terraced Fields | New fields, terraces and irrigation channels in the hills make the realm richer and bigger.
row = 2
needs = ties
icon = mission_rice_field
when = grown_dev 30
reward = prestige 10 ; modifier kar_highland_granary 15 ; claim_neighbours

mission = heartland | The Heartland | The king's highland home, with its churches, markets and fortresses, must all be in his hand.
row = 3
needs = terraces
icon = mission_eastern_european_city
when = home_area
reward = prestige 10 ; claim_neighbour_areas

mission = lowlands | The Lowland Marches | Caravans, camel-herders and slavers use the lowland routes, and the king wants them to pay him.
row = 4
needs = heartland
icon = mission_bedouins
when = grown_states 3
reward = prestige 15 ; modifier kar_coastal_reach 15

mission = king_of_kings | King of Kings | When the whole region kneels to one throne, its king may take the oldest and proudest titles of the east.
row = 5
needs = lowlands
icon = mission_empire
when = home_region
reward = prestige 25 ; stability 1

[horn_realm]
slot = 5
select = tech east_african
shield = no
modifier = kar_red_sea_trade | Red Sea Trade | Gold, ivory, incense and slaves leave the highlands for the Red Sea and Arabia. | trade_efficiency 0.10, global_trade_power 0.10
modifier = kar_faith_and_crown | Faith and Crown | Priests and king stand together, and the faith of the realm is the faith of the throne. | tolerance_own 2, religious_unity 0.10

mission = patrons | Patrons of the Faith | The king builds a great church or shrine, and the clergy and people give him their loyalty.
row = 1
icon = mission_european_church
when = allies 2
reward = prestige 10 ; adm 50

mission = caravans | Caravans to the Coast | Gold, ivory and civet are carried down to the coast, and silver and cloth are carried back.
row = 2
needs = patrons
icon = mission_asian_trader
when = treasury 150
reward = adm 50 ; modifier kar_red_sea_trade 15

mission = court | The Royal Court | A court with a chancery, a treasury and a standing guard marks the king off from the chiefs.
row = 3
needs = caravans
icon = mission_noble_council
when = stability 2 ; prestige 40
reward = prestige 10 ; modifier kar_faith_and_crown 15

mission = fortresses | Fortress and Frontier | The hill fortresses of the realm protect the roads, the churches and the royal treasure.
row = 4
needs = court
icon = mission_arabian_fort
when = dev 150 ; cities 8
reward = prestige 15 ; mil 50
