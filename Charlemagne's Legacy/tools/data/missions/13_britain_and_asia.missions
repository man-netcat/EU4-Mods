# Wessex (and the English crown it grows into), Tang China and Japan (written for 867).

[wessex_realm]
slot = 1
tags = SMT,ENG,GBR
shield = yes
modifier = kar_english_unity | English Unity | The English kingdoms are bound under one crown, and the shires obey one law. | legitimacy 1, stability_cost_modifier -0.10
modifier = kar_danelaw_broken | Danelaw Broken | The Great Army is beaten, and the Danes settle under the king's peace. | hostile_attrition 0.5, defensiveness 0.10

mission = wessex | Unite Wessex | Cornwall and the western shires have been Wessex's subjects for generations; the kingdom must be whole.
row = 1
icon = mission_unite_home_region
when = area wessex_area
reward = prestige 10 ; claim_area east_anglia_area, west_midlands_area

mission = east_anglia | East Anglia | The fens and the Norfolk coast face the Danish ships; the king needs them as a shield.
row = 2
needs = wessex
icon = mission_sea_battles
when = area east_anglia_area
reward = prestige 10 ; modifier kar_danelaw_broken 15 ; claim_area east_midlands_area

mission = mercia | The Mercian Heartland | Mercia was the overlord of the English in Offa's day; its shires are the heart of the island.
row = 3
needs = east_anglia
icon = mission_assemble_an_army
when = area west_midlands_area ; area east_midlands_area
reward = prestige 15 ; claim_area yorkshire_area, scottish_marches_area

mission = northumbria | Northumbria | The great kingdom of the north has been broken by the Danes; its churches and its fertile river-valleys wait for a king.
row = 4
needs = mercia
icon = mission_conquer_5_states
when = area yorkshire_area ; area scottish_marches_area
reward = prestige 20 ; modifier kar_english_unity 20 ; claim_area wales_area, lowlands_area
ai = 250

mission = wales | The Welsh Princes | The princes of Gwynedd, Powys and Deheubarth pay tribute only when the English host is at their gates.
row = 5
needs = northumbria
icon = mission_hands_praying
when = area wales_area
reward = prestige 20 ; adm 50

[wessex_burhs]
slot = 2
tags = SMT,ENG,GBR
shield = yes
modifier = kar_burghal_system | Burghal System | Fortified burhs a day's march apart cover the whole of the kingdom. | defensiveness 0.10, fort_maintenance_modifier -0.10

mission = allies | Friends against the Danes | Wessex needs the princes of Wales and the lords of Mercia beside her when the Great Army comes.
row = 1
icon = mission_alliances
when = allies 1
reward = prestige 10 ; dip 50

mission = treasury | Silver for the Fyrd | The king pays his thegns and his reeves in silver, and he must have enough of it to fight a long war.
row = 2
needs = allies
icon = mission_war_chest
when = treasury 300
reward = adm 50

mission = burhs | The Burghal Hidage | A ring of burhs across the kingdom, each manned by the men of its hidage, makes the realm safe from raiders.
row = 3
needs = treasury, wessex_realm:east_anglia
icon = mission_great_wall
when = dev 200 ; prestige 40
reward = prestige 10 ; modifier kar_burghal_system 20

