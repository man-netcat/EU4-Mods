# The peoples between the Elbe and the Dnieper and the Balkan hills: small realms that grow into kingdoms (written for 867).

[polans_rise]
slot = 1
tags = WIE,KUJ,LEC,PLO,STZ,SAN,TRN,KRA,SIL,POL
shield = yes
modifier = kar_piast_state | Piast State | A ring of stockaded towns holds the Polans together under one duke, and the dues come to Gniezno. | legitimacy 1, global_tax_modifier 0.05
modifier = kar_polish_heartland | Polish Heartland | The fields between the Vistula and the Oder are tilled by one people under one law. | production_efficiency 0.10, global_unrest -1

mission = polanie | The Land of the Polans | The Polans of Gniezno and Poznan are the core of the nation; the fields of the Warta must be under one duke.
row = 1
icon = mission_unite_home_region
when = area wielkopolska_area
reward = prestige 10 ; claim_area kuyavia_area, central_poland_area

mission = kuyavia | Kuyavia and Leczyca | The Goplo lake and the salt of Kuyavia are the Polans' tributaries, and the dukes of Leczyca have long been their rivals.
row = 2
needs = polanie
icon = mission_assemble_an_army
when = area kuyavia_area ; area central_poland_area
reward = prestige 10 ; modifier kar_piast_state 15 ; claim_area mazovia_area

mission = mazovia | The Mazovian Plain | The dukes of Plock hold the middle Vistula, a country of forests, marshes and amber roads.
row = 3
needs = kuyavia
icon = mission_eastern_european_city
when = area mazovia_area
reward = prestige 15 ; claim_area malopolska_area, sandomierz_area

mission = malopolska | Lesser Poland | Cracow and the Vistulans are rich in salt and lead, and are the strongest of the western Slavic tribes.
row = 4
needs = mazovia
icon = mission_great_wall
when = area malopolska_area ; area sandomierz_area
reward = prestige 15 ; claim_area silesia_area

mission = silesia | Silesia | The Oder valley is the kingdom's western gate, and the Slavic tribes there trade with Bohemia and Moravia.
row = 5
needs = malopolska
icon = mission_crusade_for_varna
when = area silesia_area
reward = prestige 25 ; modifier kar_polish_heartland 20 ; claim_area west_prussia_area
ai = 250

