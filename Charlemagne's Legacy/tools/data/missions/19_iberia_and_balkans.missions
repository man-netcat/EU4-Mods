# Iberia beyond the Reconquista files, and the Balkans (written for 867): Aragon and the Catalan counts, the Castilian counts, the Andalusi emirs,
# Bulgaria, the Croats, the Serbs of the coast, Crete, the Vlachs, Bukovina, Balaton and the Avar remnants.

[aragon_rise]
slot = 1
tags = HUE,GIR,URG,ARA
shield = yes
modifier = kar_crown_of_aragon | Crown of Aragon | Aragonese, Catalan and Valencian lands share one crown and one set of Cortes. | legitimacy 1, stability_cost_modifier -0.10
modifier = kar_mediterranean_ports | Mediterranean Ports | Barcelona, Valencia and Palma trade with Italy, Africa and the Levant. | trade_efficiency 0.10, galley_power 0.10

mission = aragon | The Ebro Frontier | Saragossa and the Ebro valley open the road from the Pyrenees to the sea; whoever holds them commands Aragon.
row = 1
icon = mission_unite_home_region
when = area aragon_area
reward = prestige 10 ; claim_area catalonia_area

mission = catalonia | The Catalan Counties | Barcelona, Girona and Urgell are the old Frankish march; their counts are rich, and their ships are growing.
row = 2
needs = aragon
icon = mission_hanseatic_city
when = area catalonia_area
reward = prestige 15 ; modifier kar_crown_of_aragon 15 ; claim_area valencia_area

mission = valencia | The Valencian Huerta | Valencia's irrigated plain is the richest farmland in the east of the peninsula.
row = 3
needs = catalonia
icon = mission_rice_field
when = area valencia_area
reward = prestige 15 ; claim_area baleares_area

mission = baleares | The Balearic Isles | Mallorca and Minorca keep the sea road to Italy and Africa and are home to Moorish corsairs.
row = 4
needs = valencia
icon = mission_galleys_in_port
when = area baleares_area
reward = prestige 15 ; modifier kar_mediterranean_ports 15 ; claim_area corsica_sardinia_area

mission = sardinia | Sardinia and Corsica | The two islands hold the middle of the western Mediterranean, and whoever has them has the sea.
row = 5
needs = baleares
icon = mission_invade_island
when = area corsica_sardinia_area
reward = prestige 25 ; stability 1

[castile_counties_rise]
slot = 1
tags = BGS,VLL,CUE,SLM
shield = yes
modifier = kar_castle_lands | Land of Castles | Stone castles line the plateau and the border with the Moors, and the counts hold them. | defensiveness 0.10, fort_maintenance_modifier -0.10
modifier = kar_castilian_repopulation | Castilian Repopulation | Settlers and monks refill the empty plateau, and the counts distribute land to them. | global_tax_modifier 0.10, global_unrest -1

mission = castle_lands | The Castle Lands | The high plateau of Old Castile, studded with castles, is the front line against the emirs of Cordoba and Toledo.
row = 1
icon = mission_unite_home_region
when = area castille_area
reward = prestige 10 ; claim_area basque_country

mission = rioja | Rioja and Alava | The upper Ebro and the Basque hills join Old Castile to Navarre and the road to Aragon.
row = 2
needs = castle_lands
icon = mission_great_wall
when = area basque_country
reward = prestige 10 ; modifier kar_castle_lands 15 ; claim_area asturias_area

mission = mountains | The Mountain Heartland | The Cantabrian hills and the Asturian valleys are where Castile began, and where the kings of Oviedo still sit.
row = 3
needs = rioja
icon = mission_assemble_an_army
when = area asturias_area
reward = prestige 15 ; claim_area toledo_area

mission = toledo | The City of Toledo | Toledo on its rock is the old Visigothic capital and the key to the Tagus valley.
row = 4
needs = mountains
icon = mission_arabian_fort
when = area toledo_area
reward = prestige 20 ; modifier kar_castilian_repopulation 20 ; claim_area extremadura_area

mission = extremadura | The Tagus Marches | The marches between the Tagus and the Guadiana are lonely and dangerous, and the counts there hold large estates.
row = 5
needs = toledo
icon = mission_cossack_cavalry
when = area extremadura_area
reward = prestige 20 ; adm 50

