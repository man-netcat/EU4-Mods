mission = pact | Pacts of the Taifas | The emirs of al-Andalus survive by treaty, tribute and marriage; the first step is a friend in the next valley.
row = 1
icon = mission_alliances
when = allies 1
reward = prestige 10 ; dip 50

mission = vega | The Home Vega | The fertile river plain around the capital must be wholly the emir's.
row = 2
needs = pact
icon = mission_rice_field
when = home_area
reward = prestige 10 ; modifier kar_emirate_secured 15 ; claim_neighbour_areas

mission = irrigation | Irrigation and Orchards | Waterwheels, canals and orchards make the emir's lands richer than anything in Christendom.
row = 3
needs = vega
icon = mission_early_game_buildings
when = grown_dev 30
reward = prestige 10 ; modifier kar_taifa_prosperity 15 ; claim_neighbours

mission = neighbours | The Neighbouring Emirs | Two or three neighbouring emirates fall to the emir's armies or are forced to kneel to him.
row = 4
needs = irrigation
icon = mission_persian_soldiers
when = grown_states 3
reward = prestige 15 ; adm 50

mission = caliphate | Heir of the Caliphs | A powerful emir with a rich court and a long reach claims the heritage of the Umayyad caliphs.
row = 5
needs = neighbours
icon = mission_mosque
when = dev 300 ; prestige 60
reward = prestige 25 ; stability 1

