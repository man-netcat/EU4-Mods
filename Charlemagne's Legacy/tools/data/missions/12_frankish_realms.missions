icon = mission_empire
when = area wallonia_area ; area lorraine_area ; area alsace_area
reward = prestige 25 ; modifier kar_lotharingia_reunited 20 ; stability 1

[east_francia_court]
slot = 4
tags = GER
shield = yes
modifier = kar_diets_of_the_east | Diets of the East | The king holds his diets at Regensburg and Frankfurt, and the great men of the east attend him. | stability_cost_modifier -0.10, improve_relation_modifier 0.25

mission = oaths | Oaths of the Great Men | The dukes of Bavaria and Saxony and the margraves swear to the king, and the crown can rely on their support.
