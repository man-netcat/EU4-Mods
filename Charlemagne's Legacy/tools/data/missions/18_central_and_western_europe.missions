when = area liguria_area
reward = prestige 10 ; modifier kar_kingdom_of_provence 15

mission = narbonne | Narbonne and Languedoc | Septimania and the Languedoc coast were Provence's neighbour and partner in every Gothic-Frankish quarrel.
row = 3
needs = ligurian_coast
