[group_turkic]
trigger = group turkic
name = Turkic
start = cavalry_power 0.15, gov 1
bonus = gov 1
idea = The Yabghu and the Tarkhan | The clans accept a ruler by custom and give him a council of tribal heads. | stability_cost_modifier -0.10, gov 1
idea = Horse Archers | Turkic horse archers are the most mobile army of the age. | cavalry_power 0.20, shock_damage 0.10
idea = Herds and Camps | A camp moves with the season, and herds are the people's wealth. | manpower_recovery_speed 0.10, global_manpower_modifier 0.15
idea = Raiders on the Frontier | Turkic bands raid Persian, Slavic and Chinese borderlands. | loot_amount 0.20, movement_speed 0.10
