# Major Austronesian cultures, which would otherwise share one set of 104 realms.

[culture_javanese]
trigger = culture javanese
name = Javanese
start = production_efficiency 0.10, galley_power 0.10
bonus = gov 1
idea = The Rice Kingdoms | Volcanic soil and wet-rice terraces give Java the densest population of the islands. | global_tax_modifier 0.10, production_efficiency 0.10
idea = Temples of Borobudur and Prambanan | Great stone temples rise in the Kedu plain as monuments to kings and gods. | prestige 1, church_power_modifier 0.10
idea = Shailendra and Sanjaya | Two dynasties, Buddhist and Shaiva, share and rival the island's power. | tolerance_heretic 2, stability_cost_modifier -0.10
idea = Pasisir Ports | North-coast harbours carry rice, spices and cloth to the straits and to China. | trade_efficiency 0.10, global_trade_power 0.10
idea = Gamelan and Wayang | Court culture of music and shadow-play mixes Indian epic with Javanese spirit. | idea_cost -0.05, technology_cost -0.10
idea = The Village Desa | Village communities manage fields, irrigation and levies. | global_manpower_modifier 0.15, yearly_corruption -0.05
idea = Warships of the Java Sea | Javanese fleets sail to Sumatra, Borneo and Malaya. | galley_power 0.15, global_sailors_modifier 0.20

[culture_malay]
trigger = culture malay,acehnese
name = Malay
start = galley_power 0.1, trade_efficiency 0.05
bonus = gov 1
idea = Straits of Malacca | Ships pass through narrow waters controlled by the Malay ports. | global_trade_power 0.05, trade_efficiency 0.05
idea = The Orang Laut | Sea nomads pilot, scout and fight for Malay rulers. | naval_morale 0.10, global_sailors_modifier 0.20
idea = Pepper and Tin | Sumatran pepper and Malay tin are sold to Indian and Chinese traders. | global_trade_goods_size_modifier 0.10, production_efficiency 0.10
idea = The Raja and the Bendahara | The king rules with a first minister who holds the treasury and command. | administrative_efficiency 0.05, yearly_corruption -0.10
idea = River Ports | Cities along the rivers mark the line between jungle and sea. | merchants 1, trade_efficiency 0.10
idea = The Malay Rivers | Boats carry soldiers to every village along the coast. | movement_speed 0.05, galley_power 0.10
idea = Indian Traders and Religion | Indian merchants and Brahmins give Malay courts titles and rites. | tolerance_heathen 1.5, church_power_modifier 0.10

[culture_philippine]
trigger = culture bisayan,tagalog,iloko
name = Philippine
start = galley_power 0.1, defensiveness 0.10
bonus = gov 1
idea = The Barangay | The boat-community of the datu is a village, a war band and a trading house. | improve_relation_modifier 0.25, stability_cost_modifier -0.10
idea = Datu and Rajah | Chiefs rule with generosity and war prowess. | prestige 1, gov 1
idea = Gold and Pottery | Philippine goldsmiths and potters trade with China and Borneo. | global_tax_modifier 0.10, trade_efficiency 0.10
idea = Warriors of the Islands | Philippine raiders strike by sea and withdraw. | loot_amount 0.15, capture_ship_chance 0.15
idea = Rice Terraces | Mountain terraces in Luzon feed large populations. | production_efficiency 0.10, development_cost -0.10
idea = The Balangay | Large plank-built ships carry whole communities across the sea. | global_sailors_modifier 0.25, galley_power 0.15
idea = Ancestor Spirits | Anito spirits are offered feasts for success in war and harvest. | tolerance_own 2, religious_unity 0.10
