# Iberia, the British Isles, Scandinavia and the Rus.

[asturias]
trigger = tag ASU,LEO
name = Asturian
start = defensiveness 0.1, land_morale 0.10
bonus = gov 1
idea = Covadonga | The cave where Pelayo broke the Moors is the founding story of every Asturian king and the reason they fight. | prestige 1, land_morale 0.10
idea = The Gothic Succession | Alfonso III claims the Visigothic crown and the legitimacy of Toledo for a kingdom of mountain valleys. | gov 1, ae_impact -0.20
idea = The Presura | Settlers who clear and hold empty land on the Duero keep it by right, and the frontier fills with armed farmers. | development_cost -0.10, global_manpower_modifier 0.15
idea = Castles of the Frontier | Towers and walls on every ridge hold the new land against Cordoban raiders. | fort_maintenance_modifier -0.20, defensiveness 0.15
idea = Mozarabs from the South | Christians fleeing Muslim persecution bring books, craftsmen and a hatred of Cordoba. | technology_cost -0.10, tolerance_own 2
idea = The Camino of Santiago | The newly found tomb of the Apostle draws pilgrims and gold to Galicia. | church_power_modifier 0.10, global_tax_modifier 0.10
idea = Infanzones and Hidalgos | Landed warriors who answer to the king alone ride when summoned and need no wages. | cavalry_cost -0.15, cavalry_power 0.10

[galicia]
trigger = tag GAL
name = Galician
start = global_sailors_modifier 0.20, defensiveness 0.10
bonus = gov 1
idea = Finis Terrae | At the end of the known world the Galicians fish, sail and raid the Atlantic coast. | galley_power 0.15, naval_morale 0.10
idea = The Suevic Memory | The kingdom of the Suebi lasted two centuries, and Galicians do not forget they once ruled themselves. | stability_cost_modifier -0.10, reduced_liberty_desire 10
idea = The Apostle's City | Santiago's cathedral and its pilgrims make the see of Compostela as rich as a kingdom. | church_power_modifier 0.15, global_tax_modifier 0.10
idea = Hills and Hamlets | Galician farmers live in scattered villages in rain-soaked hills that no army can hold. | land_attrition -0.15, hostile_attrition 0.5
idea = Atlantic Fisheries | Whales, sardines and salt fish make the Rias a larder for the whole north. | production_efficiency 0.10, trade_efficiency 0.10
idea = Hidalgos of the Hills | Petty gentry guard their fields, fight for the king and ask little in return. | cavalry_cost -0.15, land_morale 0.10
idea = Counts Against the Northmen | Vikings have raided the Galician shore since 844, and its counts learn to answer fire with steel. | defensiveness 0.15, fort_maintenance_modifier -0.15

[al_andalus]
trigger = tag ADU,SPA
name = Cordoban
start = diplomatic_reputation 1, global_tax_modifier 0.10
bonus = gov 1
idea = The Great Mosque of Cordoba | The Umayyad emirs build and rebuild their mosque to show the world a throne that rivals Baghdad's. | prestige 1, gov 1
idea = Irrigation of the Vega | Roman aqueducts, Arab waterwheels and Berber canals water fields from Valencia to Seville. | production_efficiency 0.15, global_trade_goods_size_modifier 0.10
idea = The Slav Guard | Saqaliba slaves and Berber mercenaries serve the emir for pay and fear his courtiers more than his generals. | discipline 0.05, mercenary_discipline 0.025
idea = The Frontier Marches | The Upper, Middle and Lower Marches are held by lords whose loyalty is bought with titles and tax farms. | defensiveness 0.15, global_manpower_modifier 0.10
idea = Muladis and Mozarabs | Converts and Christians under the emir pay taxes, serve as clerks and sometimes rebel. | tolerance_heretic 2, tolerance_heathen 2
idea = Silks, Leather and Glass | Cordovan workshops send fine goods to Egypt and Baghdad by way of Almeria. | trade_efficiency 0.15, global_trade_power 0.10
idea = The Poets and Physicians | Scholars from Baghdad and Kairouan teach in Cordoba, and the emir hires them. | technology_cost -0.15, idea_cost -0.05

[egypt]
trigger = tag EGY
name = Egyptian
start = production_efficiency 0.10, caravan_power 0.1
bonus = gov 1
idea = The Nile Flood | The river rises and falls with the year, and the whole realm lives or starves by its gauge. | global_tax_modifier 0.10, global_trade_goods_size_modifier 0.10
idea = Fustat and the Nilometer | The governor's capital measures the flood on Roda island and sets the tax before the harvest. | yearly_corruption -0.10, administrative_efficiency 0.05
idea = The Coptic Scribes | Christian clerks keep the accounts of Egypt as their fathers kept them for Pharaoh and Caesar. | tolerance_heretic 2, technology_cost -0.10
idea = Papyrus, Flax and Linen | Alexandria's looms and the Fayyum's fields clothe and write for the Mediterranean world. | trade_efficiency 0.10, merchants 1
idea = The Red Sea and the Spice Road | Pilgrim ships to Jeddah and Indian merchantmen deliver pepper and silk to the Delta. | global_trade_power 0.15, caravan_power 0.1
idea = Turkish Troopers | Soldiers raised in the steppe and trained at the barracks of Fustat ride under the governor's banner. | cavalry_power 0.15, discipline 0.025
idea = The Alexandrian Pharos | The beacon and the harbour of the old Ptolemaic capital still guide ships from Crete and Tunis. | galley_power 0.15, global_sailors_modifier 0.20

